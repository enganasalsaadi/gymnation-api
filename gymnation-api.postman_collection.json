{
  "info": {
    "name": "GymNation API",
    "description": "Manual client for the GymNation take-home API. Start the container, then run the requests in order: the happy path saves memberId, agreementId and runId for later requests. Restart the container to reset state. This collection is not the hidden grader.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "planId",
      "value": "anytime-sa"
    },
    {
      "key": "memberId",
      "value": ""
    },
    {
      "key": "agreementId",
      "value": ""
    },
    {
      "key": "runId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Happy path",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('status ok', () => pm.expect(pm.response.json()).to.eql({ status: 'ok' }));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Member",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/members",
            "description": "Saves the new member id in {{memberId}}. Sent again, it returns 409 PHONE_TAKEN and saves the existing id instead.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Noura Al Harbi\",\n  \"country\": \"SA\",\n  \"phone\": \"055 123 4567\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('201, or 409 when the member already exists', () => pm.expect([201, 409]).to.include(pm.response.code));",
                  "if (pm.response.code === 201) { pm.collectionVariables.set('memberId', body.id); pm.test('phone stored as E.164', () => pm.expect(body.phone).to.eql('+966551234567')); }",
                  "if (pm.response.code === 409) pm.collectionVariables.set('memberId', body.error.existing_member_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Lookup Member",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/members/lookup?phone=%2B966551234567"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('same member', () => pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('memberId')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Plan",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/plans",
            "description": "Uses the id in {{planId}}. Sent again, it returns 409 PLAN_EXISTS, which is fine for the rest of the flow.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{planId}}\",\n  \"country\": \"SA\",\n  \"monthly\": 29900,\n  \"joining_fee\": 0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201, or 409 when the plan already exists', () => pm.expect([201, 409]).to.include(pm.response.code));",
                  "if (pm.response.code === 201) pm.test('currency from country', () => pm.expect(pm.response.json().currency).to.eql('SAR'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Agreement",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/agreements",
            "description": "Saves the new agreement id in {{agreementId}}.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"member_id\": \"{{memberId}}\",\n  \"plan_id\": \"{{planId}}\",\n  \"start_date\": \"2026-09-20\",\n  \"due_day\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('agreementId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List Invoices",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/agreements/{{agreementId}}/invoices?from=2026-09-01&to=2026-12-31",
            "description": "The brief's SA example: the first invoice is 10963 net, 1644 VAT, 12607 total."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const first = pm.response.json()[0];",
                  "pm.test('golden first invoice', () => pm.expect([first.net, first.vat, first.total]).to.eql([10963, 1644, 12607]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Reconciliation Run",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/reconciliation/runs",
            "description": "Saves the run id in {{runId}}. T-1 pays invoice 2 on its due date (MATCHED), T-2 is DECLINED, T-3 has no agreement (MISSING_FROM_LEDGER).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"month\": \"2026-10\",\n  \"rows\": [\n    {\n      \"gateway_txn_id\": \"T-1\",\n      \"agreement_id\": \"{{agreementId}}\",\n      \"amount\": 34385,\n      \"currency\": \"SAR\",\n      \"status\": \"SETTLED\",\n      \"attempted_on\": \"2026-10-01\"\n    },\n    {\n      \"gateway_txn_id\": \"T-2\",\n      \"agreement_id\": \"{{agreementId}}\",\n      \"amount\": 34385,\n      \"currency\": \"SAR\",\n      \"status\": \"DECLINED\",\n      \"attempted_on\": \"2026-10-02\"\n    },\n    {\n      \"gateway_txn_id\": \"T-3\",\n      \"agreement_id\": \"agr_unknown\",\n      \"amount\": 1000,\n      \"currency\": \"SAR\",\n      \"status\": \"SETTLED\",\n      \"attempted_on\": \"2026-10-03\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('runId', pm.response.json().id);",
                  "pm.test('verdicts', () => pm.expect(pm.response.json().rows.map((r) => r.verdict)).to.eql(['MATCHED', 'DECLINED', 'MISSING_FROM_LEDGER']));"
                ]
              }
            }
          ]
        },
        {
          "name": "Read Reconciliation Run",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/reconciliation/runs/{{runId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('same run', () => pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('runId')));"
                ]
              }
            }
          ]
        }
      ]
    },
